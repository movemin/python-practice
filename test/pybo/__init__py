from flask import Flask
from flask_migrate import Migrate
from flask_sqlalchemy import SQLAlchemy

import config

migrate = Migrate()
db = SQLAlchemy()

def create_app():
    app = Flask(__name__)
    
    app.congig.object(config)
    app.migrate(app, db)
    db(app)    
    from .views import main_view
    app.register_blueprint(main_view)
    
    from . import models
    
    return app